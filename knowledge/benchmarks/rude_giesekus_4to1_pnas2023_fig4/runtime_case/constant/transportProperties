FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      constitutiveProperties;
}

parameters
{
    type            Giesekus;

    rho             rho [1 -3 0 0 0 0 0] 0.1;
    etaS            etaS [1 -1 -1 0 0 0 0] 0.11111;
    etaP            etaP [1 -1 -1 0 0 0 0] 0.88889;
    lambda          lambda [0 0 1 0 0 0 0] 1;
    alpha           alpha [0 0 0 0 0 0 0] 0.8;

    stabilization   coupling;
}

passiveScalarProperties
{
    solvePassiveScalar off;
    D                  D [0 2 -1 0 0 0 0] 1e-09;
}